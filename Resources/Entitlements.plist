<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Kept to the minimum that a terminal actually needs. platform-application
	     plus no-container is what lets the app run outside a data container and
	     fork a shell; anything more is a liability, not a feature. -->
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.skip-library-validation</key>
	<true/>
	<!-- CarPlay shows an app only for the category it is entitled to, and only
	     navigation apps may draw their own content, so this is what puts the
	     terminal on the car's screen. Nothing else about maps is used. -->
	<key>com.apple.developer.carplay-maps</key>
	<true/>
</dict>
</plist>
